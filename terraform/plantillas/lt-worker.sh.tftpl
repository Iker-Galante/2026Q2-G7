#!/bin/bash
# User data de lt-worker (guía §8.3), generado por Terraform.
set -euxo pipefail

mount -t efs -o tls ${fs_modelos}:/ /mnt/modelos
echo "${fs_modelos}:/ /mnt/modelos efs _netdev,tls 0 0" >> /etc/fstab

aws s3 cp s3://${bucket_deploy}/worker/worker-latest.zip /opt/worker/
cd /opt/worker
unzip -o worker-latest.zip
aws s3 cp s3://${bucket_deploy}/config/worker.env /etc/ateneo.env
chmod 600 /etc/ateneo.env

# El "|| true" es obligatorio: en una instancia nueva la unidad no está cargada (guía §8.3).
systemctl reset-failed ateneo-worker || true
systemctl start ateneo-worker
