#!/bin/bash
# El constructor (decisión 06), generado por Terraform. Construye las dos imágenes con el código
# del repositorio, las sube a ECR con el hash del código como etiqueta, sube el sitio al bucket
# web y, con datos_demo, siembra el modelo y el conjunto de demostración. Después se apaga.
# El log queda en s3://${bucket_artefactos}/logs/constructor-${version}.log
set -euxo pipefail
exec > >(tee -a /var/log/constructor.log) 2>&1

subir_log_y_apagar() {
  aws s3 cp /var/log/constructor.log "s3://${bucket_artefactos}/logs/constructor-${version}.log" --region ${region} || true
  shutdown -h now
}
trap subir_log_y_apagar EXIT

dnf install -y docker unzip
systemctl start docker

mkdir -p /opt/ateneo && cd /opt/ateneo
aws s3 cp "s3://${bucket_artefactos}/${clave_codigo}" codigo.zip --region ${region}
unzip -q -o codigo.zip

aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registro}

# Las etiquetas son inmutables: si la imagen de esta versión ya está, no se vuelve a construir.
construir() {
  local repo=$1 dockerfile=$2
  if aws ecr describe-images --region ${region} --repository-name "$repo" --image-ids imageTag=${version} >/dev/null 2>&1; then
    echo "$repo:${version} ya está en ECR"
    return
  fi
  docker build -f "$dockerfile" -t "${registro}/$repo:${version}" .
  docker push "${registro}/$repo:${version}"
}
construir ateneo/backend docker/Dockerfile.backend
construir ateneo/ml docker/Dockerfile.ml

# El sitio: la etapa frontend de la imagen backend, al bucket web. config.json lo escribe Terraform.
docker build -f docker/Dockerfile.backend --target frontend -t ateneo-sitio .
contenedor=$(docker create ateneo-sitio)
docker cp "$contenedor:/src/dist" ./sitio
docker rm "$contenedor"
aws s3 sync ./sitio "s3://${bucket_web}/" --delete --exclude config.json --region ${region}

%{ if datos_demo ~}
# Datos de demostración (sección 10): el modelo de la E2 en el bucket de modelos, listo para
# «Publicar», y el conjunto reservado de 200 casos de Hugging Face en el de evaluación. Si algo
# falla acá, las imágenes y el sitio ya quedaron: solo se avisa en el log.
sembrar_demo() {
  local demo=/opt/demo
  mkdir -p $demo
  if ! aws s3api head-object --bucket ${bucket_evaluacion} --key torax-rx/v1/manifiesto.json --region ${region} >/dev/null 2>&1; then
    docker run --rm -v $demo:/salida "${registro}/ateneo/ml:${version}" \
      python tools/preparar_conjunto.py --hf hf-vision/chest-xray-pneumonia --split test --por-clase 100 --salida /salida/torax-rx/v1
    aws s3 sync $demo/torax-rx/v1 "s3://${bucket_evaluacion}/torax-rx/v1/" --region ${region}
  fi
  docker run --rm -v $demo:/salida "${registro}/ateneo/ml:${version}" \
    python tools/descargar_modelo.py --carpeta /salida/modelo --solo-descargar
  local prefijo
  prefijo=$(python3 -c "import json; d = json.load(open('$demo/modelo/modelo.json')); print('modelos/' + d['nombre'] + '/' + d['version'] + '/')")
  if ! aws s3api head-object --bucket ${bucket_modelos} --key "$prefijo"modelo.json --region ${region} >/dev/null 2>&1; then
    aws s3 cp $demo/modelo/modelo.onnx "s3://${bucket_modelos}/$prefijo"modelo.onnx --region ${region}
    aws s3 cp $demo/modelo/modelo.json "s3://${bucket_modelos}/$prefijo"modelo.json --region ${region}
  fi
}
sembrar_demo || echo "datos de demostración: no se pudieron sembrar; el resto quedó listo"
%{ endif ~}

echo "constructor terminado: ${version}"
