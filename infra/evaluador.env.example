# evaluador.env → se sube a s3://<tu bucket de deploy>/config/evaluador.env  (guía §9.5)
# Lo arma "bash infra/generar-env.sh"; esto es la referencia de qué lleva.
# Las tres primeras son obligatorias: el evaluador las valida al arrancar y sale con
# «faltan variables de entorno» si alguna no está.

BUCKET_EVALUACION=EL_NOMBRE_DE_TU_BUCKET_DE_EVALUACION
BUCKET_MODELOS=EL_NOMBRE_DE_TU_BUCKET_DE_MODELOS
DATABASE_URL=postgresql://ateneo:LA_CLAVE@ENDPOINT_DE_TU_RDS:5432/ateneo

AWS_REGION=us-east-1

# Opcionales:
# INTERVALO_SEGUNDOS=10
# DIRECTORIO_TRABAJO=/opt/worker/tmp
# MAX_FRACCION_ERRORES=0.05
