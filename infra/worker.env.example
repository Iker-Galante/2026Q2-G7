# worker.env → se sube a s3://<tu bucket de deploy>/config/worker.env  (guía §8.3)
# Lo arma "bash infra/generar-env.sh". No lleva ningún nombre de bucket: el worker es el
# único servicio que no habla con la base ni sabe dónde están los modelos — el backend le
# manda esa referencia adentro de cada pedido.

AWS_REGION=us-east-1
MODELOS_DIR=/mnt/modelos

# Opcionales:
# CACHE_SESIONES=4
# HILOS=2

# Modo sqs (Terraform los escribe solo): el worker consume la cola y escribe el resultado en la base.
# MODO_INFERENCIA=sqs
# COLA_INFERENCIAS_URL=https://sqs.us-east-1.amazonaws.com/TU_CUENTA/ateneo-inferencias
# DATABASE_URL=postgresql://ateneo:LA_CLAVE@ENDPOINT_DE_TU_RDS:5432/ateneo
# MAX_INTENTOS=3
