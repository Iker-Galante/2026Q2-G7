# backend.env → se sube a s3://ateneo-deploy-<sufijo>/config/backend.env  (guía §7.1)
# La instancia lo baja al arrancar a /etc/ateneo.env. NUNCA se commitea con valores reales.

DATABASE_URL=postgresql://ateneo:LA_CLAVE@ateneo-db.abc123.us-east-1.rds.amazonaws.com:5432/ateneo
AWS_REGION=us-east-1
BUCKET_MODELOS=ateneo-modelos-g7
BUCKET_ESTUDIOS=ateneo-estudios-g7
INFERENCIA_URL=http://internal-alb-ateneo-int-XXXX.us-east-1.elb.amazonaws.com:8081
ORIGEN_WEB=http://alb-ateneo-XXXXXXXX.us-east-1.elb.amazonaws.com

# Opcionales (tienen default):
# WEB_DIR=/opt/ateneo/web
# TIMEOUT_INFERENCIA_S=30
# MAX_INTENTOS=3
# INTERVALO_DESPACHO_S=1
# HUERFANOS_MINUTOS=2
# MAX_BYTES_ESTUDIO=20971520
