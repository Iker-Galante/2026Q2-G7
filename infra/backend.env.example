# backend.env → se sube a s3://<tu bucket de deploy>/config/backend.env  (guía §7.1)
# La instancia lo baja al arrancar a /etc/ateneo.env. NUNCA se commitea con valores reales.
#
# No hace falta escribirlo a mano: "bash infra/generar-env.sh" lo arma con los nombres de
# infra/entorno.sh y averigua solo el endpoint de la base y los DNS de los balanceadores.
# Este archivo queda como referencia de qué lleva adentro.
#
# Las cuatro primeras son obligatorias: sin alguna, el proceso muere al iniciar.

DATABASE_URL=postgresql://ateneo:LA_CLAVE@ENDPOINT_DE_TU_RDS:5432/ateneo
BUCKET_MODELOS=EL_NOMBRE_DE_TU_BUCKET_DE_MODELOS
BUCKET_ESTUDIOS=EL_NOMBRE_DE_TU_BUCKET_DE_ESTUDIOS
INFERENCIA_URL=http://DNS_DE_TU_BALANCEADOR_INTERNO:8081

# Con default:
AWS_REGION=us-east-1
ORIGEN_WEB=http://DNS_DE_TU_BALANCEADOR_EXTERNO

# Modo sqs (Terraform los escribe solo: terraform/README.md). Con estos, INFERENCIA_URL no hace falta:
# MODO_INFERENCIA=sqs
# COLA_INFERENCIAS_URL=https://sqs.us-east-1.amazonaws.com/TU_CUENTA/ateneo-inferencias
# REENVIO_MINUTOS=5
# VENCIMIENTO_EN_CURSO_MINUTOS=10

# Opcionales:
# WEB_DIR=/opt/ateneo/web
# TIMEOUT_INFERENCIA_S=30
# MAX_INTENTOS=3
# INTERVALO_DESPACHO_S=1
# HUERFANOS_MINUTOS=2
# MAX_BYTES_ESTUDIO=20971520
