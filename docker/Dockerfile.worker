# Imagen "dorada" local: las mismas dependencias que instala la guía en la AMI (§8.2),
# usada para el worker, el evaluador y las herramientas.

FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir \
      onnxruntime==1.18.0 "numpy<2" pillow pydicom boto3 fastapi uvicorn "psycopg[binary]"
WORKDIR /opt/worker
COPY ateneo_ml ./ateneo_ml
COPY worker ./worker
COPY evaluador ./evaluador
COPY tools ./tools
COPY migraciones ./migraciones
RUN mkdir -p /mnt/modelos /opt/worker/tmp
EXPOSE 8081
CMD ["uvicorn", "worker.main:app", "--host", "0.0.0.0", "--port", "8081"]
