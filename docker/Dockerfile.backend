# Imagen `backend`: la API (servicio api) y el procesador (servicio procesador, con otro comando).
# Lleva FastAPI, el driver de PostgreSQL y las migraciones; no lleva ONNX Runtime.
#
# La etapa `frontend` compila el sitio. En AWS el constructor la usa para subir el sitio al bucket
# web (el login de Cognito vuelve a ese sitio); en local, el backend lo sirve en "/".

FROM node:20-alpine AS frontend
WORKDIR /src
COPY frontend/package*.json ./
RUN npm ci 2>/dev/null || npm install
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/opt/ateneo
WORKDIR /opt/ateneo/backend
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY migraciones /opt/ateneo/migraciones
COPY tools /opt/ateneo/tools
COPY models /opt/ateneo/models
COPY --from=frontend /src/dist /opt/ateneo/web
EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
