# Imagen para correr la suite completa: backend + ateneo_ml + evaluador.
# Existe porque en Windows sin el runtime de Visual C++ no cargan onnx ni onnxruntime,
# y porque es lo mismo que correría un CI.

FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY backend/requirements.txt ./backend-requirements.txt
RUN pip install --no-cache-dir -r backend-requirements.txt \
    && pip install --no-cache-dir onnxruntime==1.18.0 onnx==1.16.2 "numpy<2" pillow pydicom pytest==8.3.4
COPY . .
CMD ["python", "-m", "pytest", "-rs"]
